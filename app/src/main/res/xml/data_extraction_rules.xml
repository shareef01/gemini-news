<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Reading history, bookmarks and cache (Room) plus app settings (DataStore)
             are user-specific and are kept out of cloud backup. -->
        <exclude domain="database" path="."/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="."/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="."/>
        <exclude domain="file" path="datastore/"/>
        <exclude domain="sharedpref" path="."/>
    </device-transfer>
</data-extraction-rules>
