<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Reading history, bookmarks and cache (Room) plus app settings (DataStore)
         are user-specific and are kept out of cloud backup. -->
    <exclude domain="database" path="."/>
    <exclude domain="file" path="datastore/"/>
    <exclude domain="sharedpref" path="."/>
</full-backup-content>
