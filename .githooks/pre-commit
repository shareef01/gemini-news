#!/bin/sh
# Block commits that introduce real secret values (e.g. NEWS_API_KEY in local.properties).
# Bypass intentionally with: git commit --no-verify
if git diff --cached --diff-filter=ACM | grep -E '^\+' | grep -qiE '(news_api_key|api[_-]?key|secret|token)\s*[:=]\s*[A-Za-z0-9+/_-]{16,}'; then
    echo "ERROR: possible secret in staged changes. Remove it or bypass with 'git commit --no-verify'." >&2
    exit 1
fi
exit 0
